# ─────────────────────────────────────────────────────────────
# QueueLess — frontend/.env.example  (safe to commit: placeholders only)
#
# Copy to ".env" only if you need to change the defaults.
# NEVER put database URLs, JWT secrets or other private values here —
# every VITE_* variable is embedded in the public JavaScript bundle.
# ─────────────────────────────────────────────────────────────

# Public URL of the backend API, WITHOUT a trailing slash.
# Leave empty for local development (Vite proxies /api to localhost:4000).
# Production example: https://queueless-api.onrender.com
VITE_API_URL=
