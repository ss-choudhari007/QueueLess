# ─────────────────────────────────────────────────────────────
# QueueLess — .gitignore
# Prevents secrets, build output, and generated files from
# being accidentally committed to Git.
# ─────────────────────────────────────────────────────────────

# ── Environment / Secrets ────────────────────────────────────
# NEVER commit .env files. They contain database URLs, API keys,
# JWT secrets, and other credentials that must stay private.
# Every .env variant in every folder is ignored (.env, .env.local,
# .env.production, .env.staging, backend/.env, …). Only placeholder
# templates named *.env.example may be committed.
.env
.env.*
*.env
!.env.example
!*.env.example

# Other files that commonly hold credentials or private keys
.npmrc
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials.json
service-account*.json

# Hosting CLIs store local project links/tokens here
.vercel/
.render/

# ── Node.js dependencies ─────────────────────────────────────
# The node_modules folder is large and is re-created by running
# "npm install". It must never be committed.
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Build output ─────────────────────────────────────────────
# Vite compiles the React app into a "dist" folder.
# This is generated code — not source code.
frontend/dist/
frontend/.vite/

# ── Prisma generated client ──────────────────────────────────
# Prisma generates database client code into node_modules/@prisma/client.
# That folder is already covered by node_modules/ above.
# The only Prisma file that should be committed is:
#   backend/prisma/schema.prisma   ← source of truth for the schema
# Migration SQL files are also committed:
#   backend/prisma/migrations/     ← committed so everyone shares the same schema history

# ── Log files ────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Operating system files ───────────────────────────────────
# macOS folder metadata
.DS_Store
# Windows thumbnail cache
Thumbs.db
desktop.ini

# ── Editor / IDE settings ────────────────────────────────────
# These are personal editor preferences and should not be shared.
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Test coverage reports ────────────────────────────────────
coverage/
.nyc_output/

# ── Miscellaneous ────────────────────────────────────────────
# Certificate/key files (Git does not support comments after a pattern)
*.pem
*.key
.cache/
tmp/

# ── Local tooling ────────────────────────────────────────────
# Machine-specific Claude files stay local. Shared project instructions
# (e.g. CLAUDE.md or .claude/settings.json) are NOT ignored on purpose.
# launch.json: local dev-server launcher for the Claude desktop app.
.claude/launch.json
# settings.local.json: personal Claude Code settings and permissions.
.claude/settings.local.json
CLAUDE.local.md
