// ─────────────────────────────────────────────────────────────
// QueueLess — backend/prisma/schema.prisma
//
// Source of truth for the database structure.
// Prisma version: 5.22.0 · Database: PostgreSQL (Neon)
//
// Key design decisions:
//   - All IDs are UUIDs — avoids sequential ID guessing.
//   - All timestamps are timestamptz (stored in UTC).
//   - Calendar "service dates" are plain DATE values computed in the
//     organization's own timezone (Organization.timezone).
//   - Token numbers are allocated through DailyCounter with an atomic
//     INSERT … ON CONFLICT DO UPDATE inside a transaction, and protected
//     by a UNIQUE constraint on QueueEntry (see docs/PROJECT_SPEC.md §4.1).
//   - A partial unique index (raw SQL in the migration) guarantees a
//     customer holds at most one active token per service per day.
//   - Staff access is granted per organization through StaffMembership.
//   - QR credentials, refresh tokens and staff invites are stored only as
//     HMAC/SHA-256 hashes — raw secrets are never persisted.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

// Account type. Chosen at registration (customer / owner) or when a staff
// invitation is accepted (staff).
enum UserRole {
  CUSTOMER
  STAFF
  OWNER
}

// Canonical token lifecycle. Transitions are enforced in
// src/services/queueService.js — see docs/PROJECT_SPEC.md §4.3.
enum TokenStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CancellationReason {
  CUSTOMER // Customer cancelled while still WAITING ("advance cancellation")
  QUEUE_CLOSED // Auto-cancelled because the service day ended
}

// Permission level of a staff member inside one organization.
// SUPERVISOR additionally may pause/resume queues and make corrections.
enum MembershipRole {
  STAFF
  SUPERVISOR
}

// ── Users and sessions ───────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique // Always stored lower-cased
  passwordHash String // bcrypt hash — never the raw password
  role         UserRole @default(CUSTOMER)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  ownedOrgs     Organization[]        @relation("OrgOwner")
  memberships   StaffMembership[]
  queueEntries  QueueEntry[]
  refreshTokens RefreshToken[]
  restrictions  CustomerRestriction[]
  auditLogs     AuditLog[]
  invitesSent   StaffInvite[]

  @@map("users")
}

// One row per login session. The JWT access token carries this row's id
// ("sid"), so revoking the row immediately invalidates the session.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique // SHA-256 of the raw random token in the cookie
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  userAgent String?
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Organizations ────────────────────────────────────────────

model Organization {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  category    String // One of ORG_CATEGORIES in src/lib/constants.js
  description String?
  address     String?
  city        String?
  phone       String?
  email       String?
  // IANA timezone, e.g. "Asia/Kolkata". Determines the service date and
  // whether the organization is currently open.
  timezone    String  @default("Asia/Kolkata")
  // Inactive organizations are hidden from public browsing and cannot
  // accept new tokens.
  isActive    Boolean @default(true)
  ownerId     String  @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  owner         User                  @relation("OrgOwner", fields: [ownerId], references: [id])
  settings      QueueSettings?
  services      Service[]
  memberships   StaffMembership[]
  invites       StaffInvite[]
  queueEntries  QueueEntry[]
  dailyCounters DailyCounter[]
  restrictions  CustomerRestriction[]
  qrCredentials QrCredential[]
  auditLogs     AuditLog[]

  @@index([ownerId])
  @@index([isActive, category])
  @@map("organizations")
}

// Per-organization queue configuration (1-to-1 with Organization).
model QueueSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  // Default maximum tokens per service per service date.
  maxDailyTokens Int @default(100)

  // Minutes a called customer has to confirm arrival before they may be
  // marked NO_SHOW. Policy default: 5 minutes.
  noShowGracePeriodMinutes Int @default(5)

  // Lifetime of each QR credential shown to the customer, in seconds.
  qrTtlSeconds Int @default(120)

  // Weekly operating hours in the organization's timezone.
  // Array of 7 objects indexed by weekday (0 = Sunday):
  //   { "closed": false, "open": "09:00", "close": "17:00" }
  weeklyHours Json

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("queue_settings")
}

model Service {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  name               String
  description        String?
  // Short prefix shown before token numbers, e.g. "GC" → GC-007.
  tokenPrefix        String    @default("A")
  // Owner's estimate of one service session; used for waiting estimates.
  avgDurationMinutes Int       @default(10)
  // Optional per-service override of QueueSettings.maxDailyTokens.
  maxDailyTokens     Int?
  // Inactive services are hidden and cannot accept tokens.
  isActive           Boolean   @default(true)
  // Paused services keep existing tokens but block new joins and call-next.
  isPaused           Boolean   @default(false)
  pausedAt           DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queueEntries  QueueEntry[]
  dailyCounters DailyCounter[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("services")
}

// ── Staff access ─────────────────────────────────────────────

// Grants a STAFF user access to one organization. A staff user may hold
// memberships in several organizations; each is authorized separately.
model StaffMembership {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole @default(STAFF)
  createdAt      DateTime       @default(now()) @db.Timestamptz
  updatedAt      DateTime       @updatedAt @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("staff_memberships")
}

// Single-use invitation link created by an owner. Only a SHA-256 hash of
// the invitation token is stored.
model StaffInvite {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  email          String
  role           MembershipRole @default(STAFF)
  tokenHash      String         @unique
  expiresAt      DateTime       @db.Timestamptz
  acceptedAt     DateTime?      @db.Timestamptz
  revokedAt      DateTime?      @db.Timestamptz
  createdById    String         @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@map("staff_invites")
}

// ── Queue ────────────────────────────────────────────────────

// One row = one token issued to one customer.
model QueueEntry {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  serviceId      String      @db.Uuid
  userId         String      @db.Uuid
  tokenNumber    Int
  // Calendar date in the organization's timezone when the token was issued.
  serviceDate    DateTime    @db.Date
  status         TokenStatus @default(WAITING)

  // ── Lifecycle timestamps (server clock) ─────────────────────
  calledAt           DateTime?           @db.Timestamptz
  // calledAt + grace period. Persisted so the policy survives restarts.
  noShowDeadline     DateTime?           @db.Timestamptz
  // Set when staff successfully validated the customer's QR credential.
  arrivalRequestedAt DateTime?           @db.Timestamptz
  // Set only when the customer explicitly confirmed arrival.
  arrivalConfirmedAt DateTime?           @db.Timestamptz
  servingAt          DateTime?           @db.Timestamptz
  completedAt        DateTime?           @db.Timestamptz
  cancelledAt        DateTime?           @db.Timestamptz
  cancellationReason CancellationReason?
  noShowAt           DateTime?           @db.Timestamptz
  // An excused no-show stays NO_SHOW for history but is not counted
  // towards restrictions. Set by an authorized staff correction.
  noShowExcused      Boolean             @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])
  qrCredentials QrCredential[]

  // No two tokens share a number within (organization, service, date).
  @@unique([organizationId, serviceId, serviceDate, tokenNumber])
  @@index([organizationId, serviceId, serviceDate, status])
  @@index([userId, status])
  @@index([status, noShowDeadline])
  @@index([userId, organizationId, status, noShowAt])
  @@map("queue_entries")
}

model DailyCounter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  serviceId      String   @db.Uuid
  serviceDate    DateTime @db.Date
  currentCount   Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, serviceId, serviceDate])
  @@map("daily_counters")
}

// Short-lived, single-use credential encoded in the customer's QR code.
// Separate from session credentials. secretHash/codeHash are HMAC-SHA256.
model QrCredential {
  id             String    @id @default(uuid()) @db.Uuid
  queueEntryId   String    @db.Uuid
  organizationId String    @db.Uuid
  secretHash     String    @unique
  // Hash of the short manual code (camera-free fallback).
  codeHash       String
  expiresAt      DateTime  @db.Timestamptz
  usedAt         DateTime? @db.Timestamptz
  usedById       String?   @db.Uuid
  revokedAt      DateTime? @db.Timestamptz
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now()) @db.Timestamptz

  queueEntry   QueueEntry   @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([queueEntryId])
  @@map("qr_credentials")
}

// Organization-specific joining restriction created by the no-show policy.
model CustomerRestriction {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  startsAt       DateTime  @db.Timestamptz
  endsAt         DateTime  @db.Timestamptz
  reason         String
  liftedAt       DateTime? @db.Timestamptz
  liftedById     String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, endsAt])
  @@index([organizationId])
  @@map("customer_restrictions")
}

// Append-only record of administrative and queue-state changes.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorId        String?  @db.Uuid // null = system (background processor)
  action         String
  entityType     String
  entityId       String?
  details        Json?
  createdAt      DateTime @default(now()) @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
