# ─────────────────────────────────────────────────────────────
# QueueLess — backend/.env.example
#
# This file is SAFE TO COMMIT. It contains placeholder values only.
# It shows you what variables the backend needs.
#
# HOW TO USE:
#   1. Copy this file and rename the copy to ".env"
#      Command: cp .env.example .env
#   2. Open your new ".env" file and fill in your real values.
#   3. Never commit ".env" — it is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
# The port number the backend server will listen on.
# 4000 is a common choice for local development.
PORT=4000

# ── Database ─────────────────────────────────────────────────
# Your Neon PostgreSQL connection string.
# Where to find it:
#   1. Go to https://console.neon.tech
#   2. Open your project → Connection Details
#   3. Copy the "Connection string" (starts with postgresql://)
#   4. Paste it below in your .env file (NOT here — this file is committed)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── Authentication ────────────────────────────────────────────
# A long, random secret used to sign JWT access tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Leave blank until Part 4 (Authentication).
JWT_SECRET=

# ── Environment ──────────────────────────────────────────────
# Set to "development" locally, "production" on the live server.
# This controls things like cookie security settings.
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────
# The URL where your frontend is running locally.
# This allows the React app to call the backend API.
# Default Vite port is 5173.
FRONTEND_URL=http://localhost:5173
