# ─────────────────────────────────────────────────────────────
# QueueLess — backend/.env.example
#
# SAFE TO COMMIT: placeholder values only.
#   1. cp .env.example .env
#   2. Fill in real values in .env (never commit .env — it is gitignored).
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=4000
# "development" locally, "production" on the live server.
NODE_ENV=development

# ── Database (Neon PostgreSQL) ───────────────────────────────
# Neon console → your project → Connection details → connection string.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Optional: database used by `npm test`. Its name MUST contain "test".
# If empty, tests use a database called "queueless_test" on the same
# server as DATABASE_URL (create it once — see README "Running tests").
TEST_DATABASE_URL=

# ── Authentication ───────────────────────────────────────────
# Long random secret for signing session tokens (min. 32 characters).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Frontend / CORS ──────────────────────────────────────────
# Origin(s) allowed to call the API and open sockets (comma-separated, no trailing slash).
FRONTEND_URL=http://localhost:5173
# Public frontend URL used in staff invitation links (defaults to the first FRONTEND_URL).
APP_URL=

# ── Cookies (optional overrides) ─────────────────────────────
# Defaults: development → SameSite=strict, Secure=false
#           production  → SameSite=none,   Secure=true  (frontend and backend on different sites)
COOKIE_SAMESITE=
COOKIE_SECURE=
COOKIE_DOMAIN=
# Number of reverse proxies in front of the app (Render/Railway: 1). Defaults to 1 in production.
TRUST_PROXY=

# ── Background processor & limits (optional) ─────────────────
# How often no-show deadlines and closed days are processed (ms).
SWEEP_INTERVAL_MS=30000
# Set to false only when another instance runs the processor.
WORKER_ENABLED=true
RATE_LIMIT_ENABLED=true

# ── Demo data (development only) ─────────────────────────────
# Password for the demo accounts created by `npm run db:seed`.
SEED_DEMO_PASSWORD=
