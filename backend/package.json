{
  "name": "queueless-backend",
  "version": "1.0.0",
  "description": "QueueLess backend — Express, Prisma, Socket.IO API",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "node prisma/seed.js",
    "db:unseed": "node prisma/unseed.js",
    "db:status": "prisma migrate status",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "5.22.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
